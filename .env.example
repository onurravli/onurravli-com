# Copy to .env. Under Docker Compose the database, ClickHouse and Redis URLs
# below are overridden with the in-network service addresses (compose.yaml);
# the values here suit `pnpm dev` against `docker compose up -d postgres clickhouse redis-http`.

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onurravli

# Admin panel (/admin). Generate the secret with: openssl rand -base64 32
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Analytics (ClickHouse)
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=analytics

# Cache and live visitors (Upstash Redis REST API, or the local shim)
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local_dev_token

# GitHub stats and project cards (a fine-grained token with read access)
GITHUB_TOKEN=

# Owner notification emails (contact form, visits, CV views)
RESEND_API_KEY=
RESEND_FROM_NAME=
RESEND_FROM_MAIL=
RESEND_TO_NAME=
RESEND_TO_MAIL=

# Shows a "PRE-PROD" ribbon when set to true
PREPROD_INDICATOR=
